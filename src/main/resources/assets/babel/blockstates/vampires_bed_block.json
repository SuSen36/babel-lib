{
  "multipart": [
    {
      "when": {
        "part": "foot",
        "facing": "north"
      },
      "apply": {
        "model": "babel:block/vampires_bed",
        "y": 180
      }
    },
    {
      "when": {
        "part": "foot",
        "facing": "east"
      },
      "apply": {
        "model": "babel:block/vampires_bed",
        "y": 270
      }
    },
    {
      "when": {
        "part": "foot",
        "facing": "south"
      },
      "apply": {
        "model": "babel:block/vampires_bed"
      }
    },
    {
      "when": {
        "part": "foot",
        "facing": "west"
      },
      "apply": {
        "model": "babel:block/vampires_bed",
        "y": 90
      }
    },
    {
      "when": {
        "part": "head",
        "facing": "north"
      },
      "apply": {
        "model": "babel:block/vampires_bed_upper",
        "y": 180
      }
    },
    {
      "when": {
        "part": "head",
        "facing": "east"
      },
      "apply": {
        "model": "babel:block/vampires_bed_upper",
        "y": 270
      }
    },
    {
      "when": {
        "part": "head",
        "facing": "south"
      },
      "apply": {
        "model": "babel:block/vampires_bed_upper"
      }
    },
    {
      "when": {
        "part": "head",
        "facing": "west"
      },
      "apply": {
        "model": "babel:block/vampires_bed_upper",
        "y": 90
      }
    }
  ]
}